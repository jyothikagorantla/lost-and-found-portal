{
  "name": "lost-and-found-portal",
  "version": "1.0.0",
  "description": "A full-stack responsive web application to report, browse, claim, and recover lost and found belongings.",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "seed": "node scripts/seedData.js",
    "create-admin": "node scripts/createAdmin.js",
    "test": "node --test tests/*.test.js",
    "smoke": "node scripts/smokeTest.js"
  },
  "keywords": [
    "lost-and-found",
    "nodejs",
    "express",
    "mongodb",
    "mongoose",
    "ejs",
    "bootstrap5"
  ],
