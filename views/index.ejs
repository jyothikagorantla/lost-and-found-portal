<%- include('partials/header') %>

<!-- Hero Section -->
<section class="hero-section text-center">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-9 col-md-11">
        <span class="badge bg-light text-dark fw-bold mb-3 px-3 py-2 rounded-pill shadow-sm">
          <i class="bi bi-geo-alt-fill text-danger me-1"></i> Campus &amp; Community Item Recovery Network
        </span>
        <h1 class="hero-title mb-3">Lost Something? Let's Help You Find It.</h1>
        <p class="hero-subtitle mx-auto mb-4">
          Connect directly with fellow students, staff, and campus security. Search recent reports, lodge lost items, or return found belongings securely.
        </p>

        <!-- Quick Search Bar -->
        <div class="row justify-content-center mb-4">
          <div class="col-lg-8 col-md-10">
            <form action="/items" method="GET" class="search-hero-box d-flex align-items-center">
              <i class="bi bi-search text-muted fs-5 ms-3"></i>
              <input type="text" name="q" class="form-control search-hero-input" placeholder="Search by item name, keyword (e.g., iPhone, Blue Backpack)..." aria-label="Search items">
              <button type="submit" class="btn btn-accent-custom px-4 py-2 rounded-pill">
                Search
              </button>
            </form>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="d-flex flex-wrap justify-content-center gap-3">
          <a href="/items/report-lost" class="btn btn-danger btn-lg px-4 py-2 rounded-pill shadow-sm">
            <i class="bi bi-exclamation-octagon me-2"></i> Report Lost Item
          </a>
          <a href="/items/report-found" class="btn btn-accent-custom btn-lg px-4 py-2 rounded-pill shadow-sm">
            <i class="bi bi-patch-check me-2"></i> Report Found Item
          </a>
          <a href="/items" class="btn btn-outline-light btn-lg px-4 py-2 rounded-pill">
            <i class="bi bi-grid-3x3-gap me-2"></i> Browse All Items
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Database Statistics Counter Section -->
<section class="mb-5">
  <div class="container">
    <div class="row g-4 text-center">
      <div class="col-md-4">
        <div class="stat-card">
          <div class="d-flex align-items-center justify-content-center mb-2">
            <div class="stat-icon bg-primary bg-opacity-10 text-primary me-3">
              <i class="bi bi-folder2-open"></i>
            </div>
            <div class="stat-number"><%= stats.totalReports %></div>
          </div>
          <h6 class="text-muted fw-semibold mb-0">Total Platform Reports</h6>
          <small class="text-secondary">Logged in community database</small>
        </div>
      </div>
      <div class="col-md-4">
        <div class="stat-card">
          <div class="d-flex align-items-center justify-content-center mb-2">
            <div class="stat-icon bg-success bg-opacity-10 text-success me-3">
              <i class="bi bi-check2-circle"></i>
            </div>
            <div class="stat-number text-success"><%= stats.resolvedCount %></div>
          </div>
          <h6 class="text-muted fw-semibold mb-0">Items Reunited</h6>
          <small class="text-secondary">Verified &amp; safely returned</small>
        </div>
      </div>
      <div class="col-md-4">
        <div class="stat-card">
          <div class="d-flex align-items-center justify-content-center mb-2">
            <div class="stat-icon bg-warning bg-opacity-10 text-warning me-3">
              <i class="bi bi-hourglass-split"></i>
            </div>
            <div class="stat-number text-primary"><%= stats.activeCount %></div>
          </div>
          <h6 class="text-muted fw-semibold mb-0">Active Searching Reports</h6>
          <small class="text-secondary">Currently open for matching</small>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Item Category Shortcuts Section -->
<section class="mb-5">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h3 class="fw-bold text-navy mb-1">Browse by Category</h3>
        <p class="text-muted small mb-0">Jump directly to specific categories of belongings</p>
      </div>
      <a href="/items" class="btn btn-sm btn-outline-custom">View All</a>
    </div>

    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-5 g-3">
      <% 
        const categoryIcons = {
          'Electronics': 'bi-laptop',
          'Wallets and Purses': 'bi-wallet2',
          'Identity Cards': 'bi-person-badge',
          'Keys': 'bi-key',
          'Bags and Luggage': 'bi-backpack',
          'Books and Stationery': 'bi-book',
          'Clothing': 'bi-tag',
          'Jewellery and Accessories': 'bi-gem',
          'Documents': 'bi-file-earmark-text',
          'Other': 'bi-box-seam'
        };
      %>
      <% categories.forEach(cat => { %>
        <div class="col">
          <a href="/items?category=<%= encodeURIComponent(cat) %>" class="category-card">
            <i class="bi <%= categoryIcons[cat] || 'bi-box' %> category-icon"></i>
            <div class="fw-semibold small"><%= cat %></div>
          </a>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- Recent Reports Section -->
<section class="mb-5">
  <div class="container">
    <!-- Recent Lost Items -->
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <h4 class="fw-bold mb-1 text-danger">
          <i class="bi bi-search me-2"></i> Recently Lost Items
        </h4>
        <p class="text-muted small mb-0">Items reported missing recently. Have you seen any of these?</p>
      </div>
      <a href="/items?type=lost" class="btn btn-sm btn-outline-danger">See All Lost</a>
    </div>

    <% if (recentLost && recentLost.length > 0) { %>
      <div class="row g-4 mb-5">
        <% recentLost.forEach(item => { %>
          <div class="col-lg-3 col-md-6">
            <div class="card-item">
              <div class="card-item-img-wrapper">
                <span class="card-badge-top-left badge-lost">LOST</span>
                <span class="card-badge-top-right badge badge-status-<%= item.status %>"><%= item.status %></span>
                <img src="<%= item.imageUrl %>" alt="<%= item.title %>" class="card-item-img" onerror="this.src='/images/default-item.svg'">
              </div>
              <div class="p-3 d-flex flex-column flex-grow-1">
                <span class="badge bg-light text-secondary border align-self-start mb-2"><%= item.category %></span>
                <h6 class="fw-bold mb-1 text-truncate" title="<%= item.title %>"><%= item.title %></h6>
                <p class="text-muted small mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                  <%= item.description %>
                </p>
                <div class="border-top pt-2 small text-secondary">
                  <div class="d-flex align-items-center text-truncate mb-1">
                    <i class="bi bi-geo-alt me-1 text-danger"></i>
                    <span class="text-truncate"><%= item.location %></span>
                  </div>
                  <div class="d-flex align-items-center text-truncate">
                    <i class="bi bi-calendar3 me-1 text-muted"></i>
                    <span><%= new Date(item.itemDate).toLocaleDateString() %></span>
                  </div>
                </div>
                <a href="/items/<%= item._id %>" class="btn btn-sm btn-outline-custom mt-3 w-100">
                  View Details
                </a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state mb-5 py-4">
        <i class="bi bi-check2-circle empty-state-icon text-success"></i>
        <h5 class="fw-bold">No active lost reports</h5>
        <p class="text-muted small">All reported belongings have either been recovered or none are logged right now.</p>
      </div>
    <% } %>

    <!-- Recent Found Items -->
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <h4 class="fw-bold mb-1 text-success">
          <i class="bi bi-check-circle me-2"></i> Recently Found Items
        </h4>
        <p class="text-muted small mb-0">Belongings discovered and handed in. Is one of these yours?</p>
      </div>
      <a href="/items?type=found" class="btn btn-sm btn-outline-success">See All Found</a>
    </div>

    <% if (recentFound && recentFound.length > 0) { %>
      <div class="row g-4">
        <% recentFound.forEach(item => { %>
          <div class="col-lg-3 col-md-6">
            <div class="card-item">
              <div class="card-item-img-wrapper">
                <span class="card-badge-top-left badge-found">FOUND</span>
                <span class="card-badge-top-right badge badge-status-<%= item.status %>"><%= item.status %></span>
                <img src="<%= item.imageUrl %>" alt="<%= item.title %>" class="card-item-img" onerror="this.src='/images/default-item.svg'">
              </div>
              <div class="p-3 d-flex flex-column flex-grow-1">
                <span class="badge bg-light text-secondary border align-self-start mb-2"><%= item.category %></span>
                <h6 class="fw-bold mb-1 text-truncate" title="<%= item.title %>"><%= item.title %></h6>
                <p class="text-muted small mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                  <%= item.description %>
                </p>
                <div class="border-top pt-2 small text-secondary">
                  <div class="d-flex align-items-center text-truncate mb-1">
                    <i class="bi bi-geo-alt me-1 text-success"></i>
                    <span class="text-truncate"><%= item.location %></span>
                  </div>
                  <div class="d-flex align-items-center text-truncate">
                    <i class="bi bi-calendar3 me-1 text-muted"></i>
                    <span><%= new Date(item.itemDate).toLocaleDateString() %></span>
                  </div>
                </div>
                <a href="/items/<%= item._id %>" class="btn btn-sm btn-outline-custom mt-3 w-100">
                  View Details &amp; Claim
                </a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state py-4">
        <i class="bi bi-box empty-state-icon"></i>
        <h5 class="fw-bold">No active found items logged</h5>
        <p class="text-muted small">Check back later or submit a lost report so finders can match with you.</p>
      </div>
    <% } %>
  </div>
</section>

<!-- How It Works Section -->
<section class="py-5 bg-white rounded-4 shadow-sm border mb-4">
  <div class="container">
    <div class="text-center mb-5">
      <h3 class="fw-bold text-navy">How the Portal Works</h3>
      <p class="text-muted">A simple, transparent 3-step process to recover your lost belongings</p>
    </div>

    <div class="row g-4 text-center">
      <div class="col-md-4">
        <div class="p-4 h-100 rounded-3 bg-light border">
          <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px; font-size: 1.5rem;">
            1
          </div>
          <h5 class="fw-bold mb-2">Report Lost or Found</h5>
          <p class="text-muted small mb-0">
            Submit a report with location, category, date, and description. Keep sensitive serial numbers private for verification.
          </p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="p-4 h-100 rounded-3 bg-light border">
          <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px; font-size: 1.5rem;">
            2
          </div>
          <h5 class="fw-bold mb-2">Smart Match &amp; Verify Claim</h5>
          <p class="text-muted small mb-0">
            Our matching engine scans for potential matches. Owners submit a verification claim explaining proof of ownership.
          </p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="p-4 h-100 rounded-3 bg-light border">
          <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px; font-size: 1.5rem;">
            3
          </div>
          <h5 class="fw-bold mb-2">Reunite Safely</h5>
          <p class="text-muted small mb-0">
            The finder or portal administrator approves the valid claim, coordinates the handover, and marks the item resolved.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
