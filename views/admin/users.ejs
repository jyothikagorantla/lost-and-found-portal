<%- include('../partials/header') %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
  <div>
    <h2 class="fw-bold text-navy mb-1">User Management</h2>
    <p class="text-muted small mb-0">Search registered users, inspect report history, and suspend or activate accounts.</p>
  </div>
  <a href="/admin" class="btn btn-outline-secondary btn-sm">
    <i class="bi bi-arrow-left me-1"></i> Admin Dashboard
  </a>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
  <div class="card-body p-3">
    <form action="/admin/users" method="GET" class="row g-2 align-items-center">
      <div class="col-md-5">
        <div class="input-group">
          <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
          <input 
            type="text" 
            name="q" 
            class="form-control" 
            placeholder="Search by name, email, or phone..." 
            value="<%= typeof query !== 'undefined' && query.q ? query.q : '' %>"
          >
        </div>
      </div>
      <div class="col-md-3">
        <select name="role" class="form-select">
          <option value="">All Roles</option>
          <option value="user" <%= typeof query !== 'undefined' && query.role === 'user' ? 'selected' : '' %>>User Only</option>
          <option value="admin" <%= typeof query !== 'undefined' && query.role === 'admin' ? 'selected' : '' %>>Admin Only</option>
        </select>
      </div>
      <div class="col-md-2">
        <select name="status" class="form-select">
          <option value="">All Statuses</option>
          <option value="active" <%= typeof query !== 'undefined' && query.status === 'active' ? 'selected' : '' %>>Active</option>
          <option value="suspended" <%= typeof query !== 'undefined' && query.status === 'suspended' ? 'selected' : '' %>>Suspended</option>
        </select>
      </div>
      <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary-custom flex-grow-1">Filter</button>
        <a href="/admin/users" class="btn btn-light border"><i class="bi bi-x"></i></a>
      </div>
    </form>
  </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light small">
        <tr>
          <th class="ps-3 py-3">User Details</th>
          <th>Contact</th>
          <th>Role</th>
          <th>Status</th>
          <th>Reports</th>
          <th>Claims</th>
          <th>Joined</th>
          <th class="text-end pe-3">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (users && users.length > 0) { %>
          <% users.forEach(u => { %>
            <tr>
              <td class="ps-3 py-3">
                <div class="fw-bold text-navy"><%= u.name %></div>
                <small class="text-muted"><%= u.email %></small>
              </td>
              <td class="small text-secondary">
                <%= u.phone || 'No phone' %>
              </td>
              <td>
                <span class="badge <%= u.role === 'admin' ? 'bg-danger' : 'bg-secondary' %>">
                  <%= u.role.toUpperCase() %>
                </span>
              </td>
              <td>
                <span class="badge <%= u.accountStatus === 'active' ? 'bg-success' : 'bg-warning text-dark' %>">
                  <%= u.accountStatus.toUpperCase() %>
                </span>
              </td>
              <td class="small fw-semibold"><%= u.reportCount %></td>
              <td class="small fw-semibold"><%= u.claimCount %></td>
              <td class="small text-muted"><%= new Date(u.createdAt).toLocaleDateString() %></td>
              <td class="text-end pe-3">
                <% if (u._id.toString() !== currentUser._id.toString()) { %>
                  <form action="/admin/users/<%= u._id %>/toggle-status" method="POST" class="d-inline">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <button 
                      type="submit" 
                      class="btn btn-sm <%= u.accountStatus === 'active' ? 'btn-outline-warning' : 'btn-outline-success' %>" 
                      data-confirm="Are you sure you want to <%= u.accountStatus === 'active' ? 'SUSPEND' : 'REACTIVATE' %> <%= u.name %>?"
                    >
                      <i class="bi <%= u.accountStatus === 'active' ? 'bi-slash-circle' : 'bi-check-circle' %> me-1"></i>
                      <%= u.accountStatus === 'active' ? 'Suspend' : 'Reactivate' %>
                    </button>
                  </form>
                <% } else { %>
                  <span class="badge bg-light text-muted border">Current User</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="8" class="text-center py-4 text-muted">
              No users match your criteria.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
