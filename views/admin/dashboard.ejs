<%- include('../partials/header') %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
  <div>
    <div class="d-flex align-items-center gap-2">
      <h2 class="fw-bold text-navy mb-0">Administrator Control Center</h2>
      <span class="badge bg-danger">ADMIN</span>
    </div>
    <p class="text-muted small mb-0">Platform overview, system statistics, user moderation, and audit logs.</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/admin/users" class="btn btn-outline-custom btn-sm">
      <i class="bi bi-people me-1"></i> Manage Users
    </a>
    <a href="/admin/items" class="btn btn-outline-custom btn-sm">
      <i class="bi bi-box-seam me-1"></i> Moderate Items
    </a>
    <a href="/admin/claims" class="btn btn-outline-custom btn-sm">
      <i class="bi bi-clipboard-check me-1"></i> Review Claims
    </a>
  </div>
</div>

<!-- Admin Stat Cards Grid -->
<div class="row g-3 mb-4">
  <div class="col-sm-6 col-md-4 col-xl-2">
    <div class="stat-card">
      <div class="stat-number"><%= stats.totalUsers %></div>
      <div class="text-muted small fw-semibold">Total Users</div>
      <small class="text-secondary">Registered accounts</small>
    </div>
  </div>

  <div class="col-sm-6 col-md-4 col-xl-2">
    <div class="stat-card">
      <div class="stat-number text-danger"><%= stats.totalLost %></div>
      <div class="text-muted small fw-semibold">Lost Reports</div>
      <small class="text-secondary">Items reported missing</small>
    </div>
  </div>

  <div class="col-sm-6 col-md-4 col-xl-2">
    <div class="stat-card">
      <div class="stat-number text-success"><%= stats.totalFound %></div>
      <div class="text-muted small fw-semibold">Found Reports</div>
      <small class="text-secondary">Items discovered</small>
    </div>
  </div>

  <div class="col-sm-6 col-md-4 col-xl-2">
    <div class="stat-card">
      <div class="stat-number text-primary"><%= stats.activeReports %></div>
      <div class="text-muted small fw-semibold">Active Searching</div>
      <small class="text-secondary">Pending matching</small>
    </div>
  </div>

  <div class="col-sm-6 col-md-4 col-xl-2">
    <div class="stat-card">
      <div class="stat-number text-success"><%= stats.resolvedReports %></div>
      <div class="text-muted small fw-semibold">Items Resolved</div>
      <small class="text-secondary">Reunited with owners</small>
    </div>
  </div>

  <div class="col-sm-6 col-md-4 col-xl-2">
    <div class="stat-card">
      <div class="stat-number text-warning"><%= stats.pendingClaims %></div>
      <div class="text-muted small fw-semibold">Pending Claims</div>
      <small class="text-secondary">Awaiting verification</small>
    </div>
  </div>
</div>

<div class="row g-4 mb-4">
  <!-- Recent Item Reports -->
  <div class="col-lg-6">
    <div class="card border-0 shadow-sm rounded-4 h-100">
      <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-navy">
          <i class="bi bi-box-seam me-2 text-primary"></i> Recent Item Reports
        </h6>
        <a href="/admin/items" class="btn btn-sm btn-outline-custom">View All</a>
      </div>
      <div class="card-body p-0">
        <% if (recentItems && recentItems.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light small">
                <tr>
                  <th class="ps-3">Item</th>
                  <th>Type</th>
                  <th>Status</th>
                  <th>Reported By</th>
                </tr>
              </thead>
              <tbody>
                <% recentItems.forEach(item => { %>
                  <tr>
                    <td class="ps-3">
                      <a href="/items/<%= item._id %>" class="fw-semibold text-dark text-decoration-none">
                        <%= item.title %>
                      </a>
                    </td>
                    <td>
                      <span class="badge <%= item.type === 'lost' ? 'badge-lost' : 'badge-found' %>">
                        <%= item.type %>
                      </span>
                    </td>
                    <td>
                      <span class="badge badge-status-<%= item.status %>" style="font-size: 0.7rem;">
                        <%= item.status %>
                      </span>
                    </td>
                    <td class="small text-muted">
                      <%= item.reportedBy ? item.reportedBy.name : 'Unknown' %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p class="text-muted p-4 mb-0 text-center">No items logged yet.</p>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Recent Platform Claims -->
  <div class="col-lg-6">
    <div class="card border-0 shadow-sm rounded-4 h-100">
      <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-navy">
          <i class="bi bi-clipboard-check me-2 text-primary"></i> Recent Ownership Claims
        </h6>
        <a href="/admin/claims" class="btn btn-sm btn-outline-custom">View All</a>
      </div>
      <div class="card-body p-0">
        <% if (recentClaims && recentClaims.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light small">
                <tr>
                  <th class="ps-3">Item</th>
                  <th>Claimant</th>
                  <th>Status</th>
                  <th class="text-end pe-3">Action</th>
                </tr>
              </thead>
              <tbody>
                <% recentClaims.forEach(claim => { %>
                  <tr>
                    <td class="ps-3">
                      <span class="fw-semibold text-truncate d-inline-block" style="max-width: 160px;">
                        <%= claim.item ? claim.item.title : 'Deleted' %>
                      </span>
                    </td>
                    <td class="small"><%= claim.claimant ? claim.claimant.name : 'Unknown' %></td>
                    <td>
                      <span class="badge <%= claim.status === 'approved' ? 'bg-success' : (claim.status === 'rejected' ? 'bg-danger' : 'bg-warning text-dark') %>" style="font-size: 0.7rem;">
                        <%= claim.status %>
                      </span>
                    </td>
                    <td class="text-end pe-3">
                      <a href="/claims/<%= claim._id %>" class="btn btn-sm btn-light border py-1 px-2">
                        <i class="bi bi-eye"></i>
                      </a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p class="text-muted p-4 mb-0 text-center">No claims submitted yet.</p>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Recent User Registrations -->
<div class="card border-0 shadow-sm rounded-4">
  <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
    <h6 class="fw-bold mb-0 text-navy">
      <i class="bi bi-person-plus me-2 text-primary"></i> Newly Registered Users
    </h6>
    <a href="/admin/users" class="btn btn-sm btn-outline-custom">Manage All Users</a>
  </div>
  <div class="card-body p-0">
    <% if (recentUsers && recentUsers.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light small">
            <tr>
              <th class="ps-3">User</th>
              <th>Email</th>
              <th>Role</th>
              <th>Account Status</th>
              <th>Joined Date</th>
            </tr>
          </thead>
          <tbody>
            <% recentUsers.forEach(u => { %>
              <tr>
                <td class="ps-3 fw-semibold"><%= u.name %></td>
                <td class="small text-muted"><%= u.email %></td>
                <td>
                  <span class="badge <%= u.role === 'admin' ? 'bg-danger' : 'bg-secondary' %>">
                    <%= u.role.toUpperCase() %>
                  </span>
                </td>
                <td>
                  <span class="badge <%= u.accountStatus === 'active' ? 'bg-success' : 'bg-warning text-dark' %>">
                    <%= u.accountStatus.toUpperCase() %>
                  </span>
                </td>
                <td class="small text-muted"><%= new Date(u.createdAt).toLocaleDateString() %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
