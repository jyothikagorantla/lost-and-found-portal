<%- include('../partials/header') %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
  <div>
    <h2 class="fw-bold text-navy mb-1">Ownership Claims Moderation</h2>
    <p class="text-muted small mb-0">Platform-wide overview of all claims, claimant proof, and resolution status.</p>
  </div>
  <a href="/admin" class="btn btn-outline-secondary btn-sm">
    <i class="bi bi-arrow-left me-1"></i> Admin Dashboard
  </a>
</div>

<!-- Filter by status -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
  <div class="card-body p-3">
    <div class="d-flex flex-wrap gap-2">
      <a href="/admin/claims" class="btn btn-sm <%= !query.status ? 'btn-primary-custom' : 'btn-light border' %>">
        All Claims (<%= claims.length %>)
      </a>
      <a href="/admin/claims?status=pending" class="btn btn-sm <%= query.status === 'pending' ? 'btn-warning text-dark' : 'btn-light border' %>">
        Pending Verification
      </a>
      <a href="/admin/claims?status=approved" class="btn btn-sm <%= query.status === 'approved' ? 'btn-success' : 'btn-light border' %>">
        Approved Claims
      </a>
      <a href="/admin/claims?status=rejected" class="btn btn-sm <%= query.status === 'rejected' ? 'btn-danger' : 'btn-light border' %>">
        Rejected Claims
      </a>
    </div>
  </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light small">
        <tr>
          <th class="ps-3 py-3">Referenced Item</th>
          <th>Claimant</th>
          <th>Explanation Excerpt</th>
          <th>Status</th>
          <th>Reviewed By</th>
          <th>Date Filed</th>
          <th class="text-end pe-3">Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (claims && claims.length > 0) { %>
          <% claims.forEach(claim => { %>
            <tr>
              <td class="ps-3 py-3">
                <% if (claim.item) { %>
                  <a href="/items/<%= claim.item._id %>" class="fw-semibold text-navy text-decoration-none">
                    <%= claim.item.title %>
                  </a>
                  <small class="text-muted d-block"><%= claim.item.category %></small>
                <% } else { %>
                  <span class="text-muted small">Item Removed</span>
                <% } %>
              </td>
              <td>
                <div class="fw-semibold small"><%= claim.claimant ? claim.claimant.name : 'Unknown' %></div>
                <small class="text-muted"><%= claim.claimant ? claim.claimant.email : '' %></small>
              </td>
              <td class="small text-secondary" style="max-width: 260px;">
                <span class="text-truncate d-block" title="<%= claim.explanation %>">
                  <%= claim.explanation %>
                </span>
              </td>
              <td>
                <span class="badge <%= claim.status === 'approved' ? 'bg-success' : (claim.status === 'rejected' ? 'bg-danger' : 'bg-warning text-dark') %>">
                  <%= claim.status.toUpperCase() %>
                </span>
              </td>
              <td class="small text-muted">
                <%= claim.reviewedBy ? claim.reviewedBy.name : '-' %>
              </td>
              <td class="small text-muted"><%= new Date(claim.createdAt).toLocaleDateString() %></td>
              <td class="text-end pe-3">
                <a href="/claims/<%= claim._id %>" class="btn btn-sm btn-primary-custom py-1 px-3">
                  <i class="bi bi-box-arrow-up-right me-1"></i> Review
                </a>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7" class="text-center py-4 text-muted">
              No claims found under this filter.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
