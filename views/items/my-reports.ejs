<%- include('../partials/header') %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
  <div>
    <h2 class="fw-bold text-navy mb-1">My Reports</h2>
    <p class="text-muted small mb-0">Track, update, or resolve the lost and found items you have submitted.</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/items/report-lost" class="btn btn-danger btn-sm">
      <i class="bi bi-plus-circle me-1"></i> Report Lost
    </a>
    <a href="/items/report-found" class="btn btn-accent-custom btn-sm">
      <i class="bi bi-plus-circle me-1"></i> Report Found
    </a>
  </div>
</div>

<!-- Filters bar -->
<div class="bg-white p-3 rounded-4 shadow-sm border mb-4">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
    <div class="d-flex flex-wrap gap-2">
      <a href="/items/my-reports" class="btn btn-sm <%= currentFilter.type === 'all' && currentFilter.status === 'all' ? 'btn-primary-custom' : 'btn-light border' %>">
        All Reports (<%= reports.length %>)
      </a>
      <a href="/items/my-reports?type=lost" class="btn btn-sm <%= currentFilter.type === 'lost' ? 'btn-danger' : 'btn-light border' %>">
        Lost Only
      </a>
      <a href="/items/my-reports?type=found" class="btn btn-sm <%= currentFilter.type === 'found' ? 'btn-success' : 'btn-light border' %>">
        Found Only
      </a>
      <a href="/items/my-reports?status=active" class="btn btn-sm <%= currentFilter.status === 'active' ? 'btn-primary-custom' : 'btn-light border' %>">
        Active Only
      </a>
      <a href="/items/my-reports?status=resolved" class="btn btn-sm <%= currentFilter.status === 'resolved' ? 'btn-success' : 'btn-light border' %>">
        Resolved Only
      </a>
    </div>
  </div>
</div>

<% if (reports && reports.length > 0) { %>
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light small">
          <tr>
            <th class="ps-3 py-3">Item Details</th>
            <th>Type</th>
            <th>Category</th>
            <th>Location</th>
            <th>Status</th>
            <th>Claims</th>
            <th>Reported Date</th>
            <th class="text-end pe-3">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% reports.forEach(item => { %>
            <tr>
              <td class="ps-3 py-3">
                <div class="d-flex align-items-center">
                  <img src="<%= item.imageUrl %>" alt="<%= item.title %>" class="rounded me-3 border" style="width: 48px; height: 48px; object-fit: cover;" onerror="this.src='/images/default-item.svg'">
                  <div>
                    <a href="/items/<%= item._id %>" class="fw-bold text-navy text-decoration-none">
                      <%= item.title %>
                    </a>
                    <small class="text-muted d-block text-truncate" style="max-width: 220px;">
                      <%= item.description %>
                    </small>
                  </div>
                </div>
              </td>
              <td>
                <span class="badge <%= item.type === 'lost' ? 'badge-lost' : 'badge-found' %>">
                  <%= item.type.toUpperCase() %>
                </span>
              </td>
              <td class="small text-secondary"><%= item.category %></td>
              <td class="small text-secondary text-truncate" style="max-width: 140px;" title="<%= item.location %>">
                <i class="bi bi-geo-alt me-1 text-danger"></i><%= item.location %>
              </td>
              <td>
                <span class="badge badge-status-<%= item.status %>" style="font-size: 0.75rem;">
                  <%= item.status %>
                </span>
              </td>
              <td>
                <% if (item.claimCount > 0) { %>
                  <a href="/items/<%= item._id %>" class="badge bg-warning text-dark text-decoration-none" title="Review received claims">
                    <i class="bi bi-shield-exclamation me-1"></i><%= item.claimCount %> Claim<%= item.claimCount > 1 ? 's' : '' %>
                  </a>
                <% } else { %>
                  <span class="text-muted small">0</span>
                <% } %>
              </td>
              <td class="small text-muted"><%= new Date(item.itemDate).toLocaleDateString() %></td>
              <td class="text-end pe-3">
                <div class="btn-group btn-group-sm">
                  <a href="/items/<%= item._id %>" class="btn btn-light border" title="View details">
                    <i class="bi bi-eye"></i>
                  </a>
                  <a href="/items/<%= item._id %>/edit" class="btn btn-light border text-primary" title="Edit">
                    <i class="bi bi-pencil"></i>
                  </a>
                  <form action="/items/<%= item._id %>/delete" method="POST" class="d-inline">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <button type="submit" class="btn btn-light border text-danger" title="Delete" data-confirm="Are you sure you want to delete this report?">
                      <i class="bi bi-trash3"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } else { %>
  <div class="empty-state py-5">
    <div class="empty-state-icon text-muted">
      <i class="bi bi-journal-x"></i>
    </div>
    <h4 class="fw-bold text-navy mb-2">No reports found</h4>
    <p class="text-muted small mb-4">You have not submitted any reports matching this filter.</p>
    <div class="d-flex justify-content-center gap-2">
      <a href="/items/report-lost" class="btn btn-danger">Report Lost Item</a>
      <a href="/items/report-found" class="btn btn-accent-custom">Report Found Item</a>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>
