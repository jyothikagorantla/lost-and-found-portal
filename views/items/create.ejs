<%- include('../partials/header') %>

<div class="row justify-content-center py-4">
  <div class="col-lg-8 col-md-10">
    <div class="form-card">
      <div class="d-flex align-items-center mb-4">
        <div class="p-3 rounded-circle me-3 <%= reportType === 'lost' ? 'bg-danger bg-opacity-10 text-danger' : 'bg-success bg-opacity-10 text-success' %>">
          <i class="bi <%= reportType === 'lost' ? 'bi-exclamation-octagon fs-2' : 'bi-patch-check fs-2' %>"></i>
        </div>
        <div>
          <h3 class="fw-bold text-navy mb-1">
            <%= reportType === 'lost' ? 'Report a Lost Item' : 'Report a Found Item' %>
          </h3>
          <p class="text-muted small mb-0">
            <%= reportType === 'lost' 
                ? 'Fill in detailed information to help finders identify your missing belongings.' 
                : 'Help someone recover their misplaced belonging by submitting discovery details.' %>
          </p>
        </div>
      </div>

      <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
        <div class="alert alert-danger shadow-sm">
          <ul class="mb-0 ps-3">
            <% errors.forEach(err => { %>
              <li><%= err.msg %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <form action="/items" method="POST" enctype="multipart/form-data" class="needs-validation" novalidate>
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

        <!-- Report Type Toggle -->
        <div class="mb-4 p-3 bg-light rounded-3 border">
          <label class="form-label d-block fw-bold mb-2">Report Type <span class="text-danger">*</span></label>
          <div class="form-check form-check-inline">
            <input 
              class="form-check-input" 
              type="radio" 
              name="type" 
              id="typeLost" 
              value="lost" 
              <%= (typeof formData !== 'undefined' && formData.type === 'lost') || reportType === 'lost' ? 'checked' : '' %>
              required
            >
            <label class="form-check-label text-danger fw-semibold" for="typeLost">
              <i class="bi bi-question-circle me-1"></i> I Lost an Item
            </label>
          </div>
          <div class="form-check form-check-inline">
            <input 
              class="form-check-input" 
              type="radio" 
              name="type" 
              id="typeFound" 
              value="found" 
              <%= (typeof formData !== 'undefined' && formData.type === 'found') || reportType === 'found' ? 'checked' : '' %>
              required
            >
            <label class="form-check-label text-success fw-semibold" for="typeFound">
              <i class="bi bi-check-circle me-1"></i> I Found an Item
            </label>
          </div>
        </div>

        <div class="row g-3 mb-3">
          <!-- Item Title -->
          <div class="col-md-7">
            <label for="title" class="form-label">Item Title / Name <span class="text-danger">*</span></label>
            <input
              type="text"
              class="form-control"
              id="title"
              name="title"
              placeholder="e.g. Midnight Blue Dell XPS 15 Laptop"
              value="<%= typeof formData !== 'undefined' && formData.title ? formData.title : '' %>"
              required
              minlength="2"
              maxlength="120"
            >
            <div class="invalid-feedback">Please provide an item title (2-120 characters).</div>
          </div>

          <!-- Category -->
          <div class="col-md-5">
            <label for="category" class="form-label">Category <span class="text-danger">*</span></label>
            <select class="form-select" id="category" name="category" required>
              <option value="" disabled selected>Select category...</option>
              <% categories.forEach(cat => { %>
                <option value="<%= cat %>" <%= typeof formData !== 'undefined' && formData.category === cat ? 'selected' : '' %>>
                  <%= cat %>
                </option>
              <% }) %>
            </select>
            <div class="invalid-feedback">Please select a valid category.</div>
          </div>
        </div>

        <div class="row g-3 mb-3">
          <!-- Location -->
          <div class="col-md-7">
            <label for="location" class="form-label">
              <%= reportType === 'lost' ? 'Last Seen Location' : 'Location Found' %> <span class="text-danger">*</span>
            </label>
            <div class="input-group">
              <span class="input-group-text bg-light"><i class="bi bi-geo-alt"></i></span>
              <input
                type="text"
                class="form-control"
                id="location"
                name="location"
                placeholder="e.g. Central Library, 2nd Floor Silent Room"
                value="<%= typeof formData !== 'undefined' && formData.location ? formData.location : '' %>"
                required
                minlength="2"
                maxlength="200"
              >
            </div>
            <div class="invalid-feedback">Please enter the location.</div>
          </div>

          <!-- Date Lost / Found -->
          <div class="col-md-5">
            <label for="itemDate" class="form-label">Date Lost or Found <span class="text-danger">*</span></label>
            <input
              type="date"
              class="form-control"
              id="itemDate"
              name="itemDate"
              value="<%= typeof formData !== 'undefined' && formData.itemDate ? formData.itemDate : new Date().toISOString().split('T')[0] %>"
              required
            >
            <div class="invalid-feedback">Please select a valid date (not in future).</div>
          </div>
        </div>

        <!-- Description -->
        <div class="mb-3">
          <label for="description" class="form-label">Public Description <span class="text-danger">*</span></label>
          <textarea
            class="form-control"
            id="description"
            name="description"
            rows="4"
            placeholder="Describe the item (color, brand, visible stickers, model, condition)..."
            required
            minlength="5"
            maxlength="3000"
          ><%= typeof formData !== 'undefined' && formData.description ? formData.description : '' %></textarea>
          <div class="invalid-feedback">Please provide a description (at least 5 characters).</div>
          <small class="text-muted">This description will be visible to the public to assist in recognition.</small>
        </div>

        <!-- Optional Photograph Upload -->
        <div class="mb-3">
          <label for="image" class="form-label">Upload Photograph <span class="text-muted small">(Optional)</span></label>
          <input
            type="file"
            class="form-control"
            id="image"
            name="image"
            accept="image/jpeg,image/png,image/webp,image/gif"
          >
          <small class="text-muted">Supported formats: JPEG, PNG, WebP, GIF (Max 5MB).</small>

          <div id="imagePreviewContainer" class="mt-3 d-none">
            <label class="form-label small fw-semibold text-muted d-block">Image Preview:</label>
            <img id="imagePreview" src="#" alt="Preview" class="img-thumbnail rounded" style="max-height: 200px;">
          </div>
        </div>

        <!-- Additional Private Notes -->
        <div class="mb-4 p-3 bg-light rounded-3 border">
          <label for="additionalPrivateNotes" class="form-label fw-bold mb-1">
            <i class="bi bi-shield-lock text-primary me-1"></i> Private Identifying Notes <span class="badge bg-secondary">Confidential</span>
          </label>
          <p class="text-muted small mb-2">
            Details here are <strong>never shown to the public</strong> or unverified claimants. Only you and authorized portal administrators can see them.
          </p>
          <textarea
            class="form-control"
            id="additionalPrivateNotes"
            name="additionalPrivateNotes"
            rows="2"
            placeholder="e.g. Serial number ends in '789', lock screen is a dog photo, cash amount inside, distinct scratch on bottom..."
            maxlength="1000"
          ><%= typeof formData !== 'undefined' && formData.additionalPrivateNotes ? formData.additionalPrivateNotes : '' %></textarea>
          <small class="text-muted">Helps verify genuine ownership when someone files a claim.</small>
        </div>

        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-primary-custom flex-grow-1 py-2 fs-6">
            <i class="bi bi-send-check me-2"></i> Submit Report
          </button>
          <a href="/items" class="btn btn-outline-secondary px-4 py-2">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
