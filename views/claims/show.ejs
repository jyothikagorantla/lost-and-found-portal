<%- include('../partials/header') %>

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
    <li class="breadcrumb-item"><a href="/dashboard" class="text-decoration-none">Dashboard</a></li>
    <li class="breadcrumb-item"><a href="/claims/my-claims" class="text-decoration-none">Claims</a></li>
    <li class="breadcrumb-item active" aria-current="page">Claim #<%= claim._id.toString().substring(18) %></li>
  </ol>
</nav>

<div class="row g-4">
  <!-- Left Column: Item Information -->
  <div class="col-lg-4">
    <% if (claim.item) { %>
      <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white py-3 border-bottom">
          <h6 class="fw-bold mb-0 text-navy">
            <i class="bi bi-box-seam me-2 text-primary"></i> Associated Item
          </h6>
        </div>
        <div class="card-body p-3 text-center">
          <img 
            src="<%= claim.item.imageUrl %>" 
            alt="<%= claim.item.title %>" 
            class="img-fluid rounded mb-3 border" 
            style="max-height: 180px; width: 100%; object-fit: contain;"
            onerror="this.src='/images/default-item.svg'"
          >
          <span class="badge <%= claim.item.type === 'lost' ? 'badge-lost' : 'badge-found' %> mb-2">
            <%= claim.item.type.toUpperCase() %>
          </span>
          <h5 class="fw-bold text-navy mb-1"><%= claim.item.title %></h5>
          <small class="text-muted d-block mb-3">
            <i class="bi bi-geo-alt text-danger me-1"></i><%= claim.item.location %>
          </small>
          <a href="/items/<%= claim.item._id %>" class="btn btn-sm btn-outline-custom w-100">
            <i class="bi bi-box-arrow-up-right me-1"></i> View Item Report
          </a>
        </div>
      </div>
    <% } %>

    <!-- Claimant Profile (visible to reporter and admin) -->
    <div class="card border-0 shadow-sm rounded-4">
      <div class="card-header bg-white py-3 border-bottom">
        <h6 class="fw-bold mb-0 text-navy">
          <i class="bi bi-person-badge me-2 text-primary"></i> Claimant Details
        </h6>
      </div>
      <div class="card-body p-3">
        <div class="d-flex align-items-center mb-3">
          <div class="rounded-circle bg-light p-3 me-3 text-primary fs-4">
            <i class="bi bi-person"></i>
          </div>
          <div>
            <h6 class="fw-bold mb-0"><%= claim.claimant ? claim.claimant.name : 'User' %></h6>
            <small class="text-muted">Member since <%= new Date(claim.claimant ? claim.claimant.createdAt : Date.now()).toLocaleDateString() %></small>
          </div>
        </div>

        <% if (isItemReporter || isAdmin) { %>
          <div class="small border-top pt-2">
            <div class="mb-1">
              <strong>Email:</strong> <span class="text-muted"><%= claim.claimant ? claim.claimant.email : 'N/A' %></span>
            </div>
            <% if (claim.claimant && claim.claimant.phone) { %>
              <div>
                <strong>Phone:</strong> <span class="text-muted"><%= claim.claimant.phone %></span>
              </div>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Right Column: Claim Details & Decision Interface -->
  <div class="col-lg-8">
    <div class="detail-card mb-4">
      <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
        <div>
          <span class="text-muted small">Claim Identification: #<%= claim._id %></span>
          <h4 class="fw-bold text-navy mb-0">Ownership Verification</h4>
        </div>
        <div>
          <span class="badge <%= claim.status === 'approved' ? 'bg-success' : (claim.status === 'rejected' ? 'bg-danger' : 'bg-warning text-dark') %> fs-6 px-3 py-2">
            Status: <%= claim.status.toUpperCase() %>
          </span>
        </div>
      </div>

      <!-- Explanation -->
      <div class="mb-4">
        <h6 class="fw-bold text-navy mb-2">Claimant's Evidence &amp; Proof</h6>
        <div class="p-3 bg-light rounded-3 border text-secondary" style="white-space: pre-line; line-height: 1.6;">
          <%= claim.explanation %>
        </div>
      </div>

      <!-- Supporting Image -->
      <% if (claim.evidenceImage) { %>
        <div class="mb-4">
          <h6 class="fw-bold text-navy mb-2">Attached Proof Photograph</h6>
          <a href="<%= claim.evidenceImage %>" target="_blank">
            <img src="<%= claim.evidenceImage %>" alt="Claim Evidence" class="img-thumbnail rounded" style="max-height: 250px;">
          </a>
        </div>
      <% } %>

      <!-- Review Information if already reviewed -->
      <% if (claim.reviewedAt) { %>
        <div class="alert <%= claim.status === 'approved' ? 'alert-success' : 'alert-danger' %> border-0 mb-4">
          <div class="d-flex align-items-center mb-1">
            <i class="bi <%= claim.status === 'approved' ? 'bi-check-circle-fill' : 'bi-x-circle-fill' %> fs-5 me-2"></i>
            <strong>Claim <%= claim.status.toUpperCase() %> on <%= new Date(claim.reviewedAt).toLocaleString() %></strong>
          </div>
          <% if (claim.reviewedBy) { %>
            <div class="small mb-1">Reviewed by: <%= claim.reviewedBy.name %></div>
          <% } %>
          <% if (claim.reviewNotes) { %>
            <div class="small mt-2 p-2 bg-white rounded border">
              <strong>Notes from reviewer:</strong> "<%= claim.reviewNotes %>"
            </div>
          <% } %>
        </div>
      <% } %>

      <!-- Review Form for Item Reporter or Admin -->
      <% if ((isItemReporter || isAdmin) && claim.status === 'pending') { %>
        <div class="border-top pt-4">
          <h5 class="fw-bold text-navy mb-3">
            <i class="bi bi-patch-question me-2 text-primary"></i> Decision &amp; Claim Review
          </h5>
          <p class="text-muted small mb-3">
            Review the explanation and evidence provided. If satisfied that this claimant is the rightful owner, approve the claim to coordinate the handover.
          </p>

          <form action="/claims/<%= claim._id %>/review" method="POST">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

            <div class="mb-3">
              <label for="reviewNotes" class="form-label fw-semibold">Reviewer Notes / Instructions to Claimant</label>
              <textarea
                class="form-control"
                id="reviewNotes"
                name="reviewNotes"
                rows="3"
                placeholder="e.g. Verified matching serial number. Please collect the item at the Campus Security Desk with student ID..."
                maxlength="1000"
              ></textarea>
            </div>

            <div class="d-flex gap-3">
              <button 
                type="submit" 
                name="status" 
                value="approved" 
                class="btn btn-success px-4 py-2"
                data-confirm="Are you sure you want to APPROVE this claim? The item will be marked as Claimed."
              >
                <i class="bi bi-check2-circle me-1"></i> Approve Claim
              </button>
              
              <button 
                type="submit" 
                name="status" 
                value="rejected" 
                class="btn btn-danger px-4 py-2"
                data-confirm="Are you sure you want to REJECT this claim?"
              >
                <i class="bi bi-x-circle me-1"></i> Reject Claim
              </button>
            </div>
          </form>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
