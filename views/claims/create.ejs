<%- include('../partials/header') %>

<div class="row justify-content-center py-4">
  <div class="col-lg-7 col-md-9">
    <div class="form-card">
      <div class="text-center mb-4">
        <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success rounded-circle mb-2" style="width: 54px; height: 54px;">
          <i class="bi bi-shield-check fs-2"></i>
        </div>
        <h3 class="fw-bold text-navy mb-1">Submit Ownership Claim</h3>
        <p class="text-muted small">Provide verifiable proof so the finder or administrator can safely return this item to you.</p>
      </div>

      <!-- Item Preview Summary -->
      <div class="p-3 bg-light rounded-3 border d-flex align-items-center mb-4">
        <img 
          src="<%= item.imageUrl %>" 
          alt="<%= item.title %>" 
          class="rounded me-3 border" 
          style="width: 64px; height: 64px; object-fit: cover;"
          onerror="this.src='/images/default-item.svg'"
        >
        <div>
          <span class="badge <%= item.type === 'lost' ? 'badge-lost' : 'badge-found' %> mb-1">
            <%= item.type.toUpperCase() %>
          </span>
          <h6 class="fw-bold text-navy mb-0"><%= item.title %></h6>
          <small class="text-muted">
            <i class="bi bi-geo-alt me-1"></i><%= item.location %> &bull; <%= new Date(item.itemDate).toLocaleDateString() %>
          </small>
        </div>
      </div>

      <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
        <div class="alert alert-danger shadow-sm">
          <ul class="mb-0 ps-3">
            <% errors.forEach(err => { %>
              <li><%= err.msg %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <form action="/claims/item/<%= item._id %>" method="POST" enctype="multipart/form-data" class="needs-validation" novalidate>
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

        <!-- Explanation & Proof -->
        <div class="mb-4">
          <label for="explanation" class="form-label fw-bold">
            Explanation of Ownership &amp; Identifying Proof <span class="text-danger">*</span>
          </label>
          <textarea
            class="form-control"
            id="explanation"
            name="explanation"
            rows="5"
            placeholder="Please detail why this is your item. Examples:
- Device wallpaper, serial number, IMEI, or distinctive marks
- Exact contents inside the wallet / bag
- Unique stickers, engravings, or keychains
- Approximate purchase date or serial code..."
            required
            minlength="10"
            maxlength="2000"
          ><%= typeof formData !== 'undefined' && formData.explanation ? formData.explanation : '' %></textarea>
          <div class="invalid-feedback">Please provide at least 10 characters explaining your ownership.</div>
          <small class="text-muted">The finder or admin will compare this explanation with the actual item.</small>
        </div>

        <!-- Optional Proof Image Upload -->
        <div class="mb-4">
          <label for="evidenceImage" class="form-label fw-bold">
            Supporting Evidence Photo <span class="text-muted small fw-normal">(Optional)</span>
          </label>
          <input
            type="file"
            class="form-control"
            id="evidenceImage"
            name="evidenceImage"
            accept="image/jpeg,image/png,image/webp,image/gif"
          >
          <small class="text-muted">Upload a photo of purchase receipt, prior photo of you with the item, or serial barcode.</small>
          
          <div id="imagePreviewContainer" class="mt-3 d-none">
            <label class="form-label small fw-semibold text-muted d-block">Preview:</label>
            <img id="imagePreview" src="#" alt="Preview" class="img-thumbnail rounded" style="max-height: 180px;">
          </div>
        </div>

        <!-- Notice -->
        <div class="alert alert-warning small d-flex align-items-start mb-4">
          <i class="bi bi-shield-exclamation fs-5 me-2 text-warning flex-shrink-0"></i>
          <div>
            <strong>Fraud Protection Notice:</strong> Submitting fraudulent claims is a violation of community guidelines and may result in immediate account suspension.
          </div>
        </div>

        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-accent-custom flex-grow-1 py-2 fs-6">
            <i class="bi bi-shield-check me-2"></i> Submit Claim for Review
          </button>
          <a href="/items/<%= item._id %>" class="btn btn-outline-secondary px-4 py-2">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
