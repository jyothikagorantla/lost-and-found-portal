<nav class="navbar navbar-expand-lg navbar-custom sticky-top">
  <div class="container">
    <a class="navbar-brand me-4" href="/">
      <img src="/images/logo.svg" alt="Lost &amp; Found Portal" height="38">
    </a>

    <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarMain">
      <!-- Main Nav Links -->
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <a class="nav-link <%= typeof currentPath !== 'undefined' && currentPath === '/' ? 'active' : '' %>" href="/">
            <i class="bi bi-house-door me-1"></i> Home
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/items') && !currentPath.includes('report') && !currentPath.includes('my-reports') ? 'active' : '' %>" href="/items">
            <i class="bi bi-search me-1"></i> Browse Items
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link text-danger fw-semibold <%= typeof currentPath !== 'undefined' && currentPath.includes('report-lost') ? 'active' : '' %>" href="/items/report-lost">
            <i class="bi bi-exclamation-circle me-1"></i> Report Lost
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link text-success fw-semibold <%= typeof currentPath !== 'undefined' && currentPath.includes('report-found') ? 'active' : '' %>" href="/items/report-found">
            <i class="bi bi-check-circle me-1"></i> Report Found
          </a>
        </li>
      </ul>

      <!-- User Nav / Actions -->
      <div class="d-flex align-items-center gap-2">
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <!-- Notifications Bell -->
          <a href="/notifications" class="btn btn-light position-relative rounded-circle p-2 text-secondary me-2" title="Notifications">
            <i class="bi bi-bell fs-5"></i>
            <% if (typeof unreadNotificationCount !== 'undefined' && unreadNotificationCount > 0) { %>
              <span class="nav-notification-badge"><%= unreadNotificationCount > 9 ? '9+' : unreadNotificationCount %></span>
            <% } %>
          </a>

          <!-- User Dropdown Menu -->
          <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2 rounded-pill px-3 py-1" type="button" id="userMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="bi bi-person-circle fs-5 text-primary"></i>
              <span class="fw-medium text-dark"><%= currentUser.name.split(' ')[0] %></span>
              <% if (currentUser.role === 'admin') { %>
                <span class="badge bg-danger ms-1" style="font-size: 0.65rem;">ADMIN</span>
              <% } %>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" aria-labelledby="userMenuButton" style="min-width: 200px;">
              <li class="px-3 py-2 border-bottom">
                <small class="text-muted d-block">Signed in as</small>
                <div class="fw-bold text-truncate"><%= currentUser.email %></div>
              </li>
              <li>
                <a class="dropdown-item py-2" href="/dashboard">
                  <i class="bi bi-speedometer2 me-2 text-primary"></i> My Dashboard
                </a>
              </li>
              <li>
                <a class="dropdown-item py-2" href="/items/my-reports">
                  <i class="bi bi-journal-text me-2 text-primary"></i> My Reports
                </a>
              </li>
              <li>
                <a class="dropdown-item py-2" href="/claims/my-claims">
                  <i class="bi bi-shield-check me-2 text-primary"></i> My Claims
                </a>
              </li>
              <li>
                <a class="dropdown-item py-2" href="/notifications">
                  <i class="bi bi-bell me-2 text-primary"></i> Notifications
                </a>
              </li>

              <% if (currentUser.role === 'admin') { %>
                <li><hr class="dropdown-divider"></li>
                <li><h6 class="dropdown-header text-uppercase text-danger fw-bold">Admin Portal</h6></li>
                <li>
                  <a class="dropdown-item py-2" href="/admin">
                    <i class="bi bi-gear-wide-connected me-2 text-danger"></i> Admin Dashboard
                  </a>
                </li>
                <li>
                  <a class="dropdown-item py-2" href="/admin/users">
                    <i class="bi bi-people me-2 text-danger"></i> Manage Users
                  </a>
                </li>
                <li>
                  <a class="dropdown-item py-2" href="/admin/items">
                    <i class="bi bi-box-seam me-2 text-danger"></i> Moderate Items
                  </a>
                </li>
                <li>
                  <a class="dropdown-item py-2" href="/admin/claims">
                    <i class="bi bi-clipboard-check me-2 text-danger"></i> All Claims
                  </a>
                </li>
              <% } %>

              <li><hr class="dropdown-divider"></li>
              <li>
                <form action="/auth/logout" method="POST" class="m-0 p-0">
                  <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                  <button type="submit" class="dropdown-item py-2 text-danger">
                    <i class="bi bi-box-arrow-right me-2"></i> Log Out
                  </button>
                </form>
              </li>
            </ul>
          </div>
        <% } else { %>
          <a href="/auth/login" class="btn btn-outline-custom">Log In</a>
          <a href="/auth/register" class="btn btn-accent-custom">Register</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
