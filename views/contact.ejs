<%- include('partials/header') %>

<div class="row justify-content-center py-4">
  <div class="col-lg-9 col-md-11">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white mb-4">
      <div class="text-center mb-5">
        <h2 class="fw-bold text-navy">Help &amp; Contact Support</h2>
        <p class="text-muted mx-auto" style="max-width: 600px;">
          Have questions, need assistance with a disputed claim, or need to locate the nearest lost-and-found repository desk?
        </p>
      </div>

      <div class="row g-4 mb-5">
        <div class="col-md-4">
          <div class="p-3 bg-light rounded-3 text-center h-100">
            <i class="bi bi-geo-alt-fill text-danger fs-2 mb-2 d-block"></i>
            <h6 class="fw-bold text-navy">Central Desk</h6>
            <p class="text-muted small mb-0">Campus Security &amp; Services Center, Building A, Ground Floor.</p>
          </div>
        </div>

        <div class="col-md-4">
          <div class="p-3 bg-light rounded-3 text-center h-100">
            <i class="bi bi-clock-fill text-primary fs-2 mb-2 d-block"></i>
            <h6 class="fw-bold text-navy">Collection Hours</h6>
            <p class="text-muted small mb-0">Monday &ndash; Friday: 8:00 AM &ndash; 6:00 PM<br>Saturday: 9:00 AM &ndash; 1:00 PM</p>
          </div>
        </div>

        <div class="col-md-4">
          <div class="p-3 bg-light rounded-3 text-center h-100">
            <i class="bi bi-envelope-at-fill text-teal fs-2 mb-2 d-block"></i>
            <h6 class="fw-bold text-navy">Support Email</h6>
            <p class="text-muted small mb-0">support@lostandfound.campus.edu<br>Phone: +1 (555) 019-2831</p>
          </div>
        </div>
      </div>

      <!-- Demonstration Feedback / Inquiry Form -->
      <div class="p-4 bg-light rounded-4 border">
        <h5 class="fw-bold text-navy mb-3">Send Us a Message</h5>
        <form onsubmit="event.preventDefault(); alert('Thank you for contacting us! Our team will respond shortly.'); this.reset();">
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Your Name</label>
              <input type="text" class="form-control" placeholder="John Doe" required>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Your Email</label>
              <input type="email" class="form-control" placeholder="john@example.com" required>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold">Subject</label>
            <input type="text" class="form-control" placeholder="Inquiry about Claim #..." required>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold">Message</label>
            <textarea class="form-control" rows="4" placeholder="How can our support team assist you today?" required></textarea>
          </div>
          <button type="submit" class="btn btn-primary-custom px-4 py-2">
            <i class="bi bi-send me-1"></i> Send Inquiry
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
