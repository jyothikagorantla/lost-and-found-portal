<%- include('partials/header') %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
  <div>
    <h2 class="fw-bold text-navy mb-1">
      Welcome back, <%= currentUser.name %>!
    </h2>
    <p class="text-muted small mb-0">
      Manage your lost &amp; found reports, track ownership claims, and check recent activity.
    </p>
  </div>
  <div class="d-flex gap-2">
    <a href="/items/report-lost" class="btn btn-danger btn-sm px-3">
      <i class="bi bi-plus-circle me-1"></i> Report Lost
    </a>
    <a href="/items/report-found" class="btn btn-accent-custom btn-sm px-3">
      <i class="bi bi-plus-circle me-1"></i> Report Found
    </a>
  </div>
</div>

<!-- Personal Stats Counters -->
<div class="row g-3 mb-4">
  <div class="col-sm-6 col-lg-3">
    <div class="stat-card">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <div class="stat-number"><%= stats.totalReports %></div>
          <div class="text-muted small fw-semibold">My Total Reports</div>
        </div>
        <div class="stat-icon bg-primary bg-opacity-10 text-primary">
          <i class="bi bi-file-earmark-text"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-lg-3">
    <div class="stat-card">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <div class="stat-number text-danger"><%= stats.lostCount %></div>
          <div class="text-muted small fw-semibold">Lost Items Reported</div>
        </div>
        <div class="stat-icon bg-danger bg-opacity-10 text-danger">
          <i class="bi bi-question-circle"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-lg-3">
    <div class="stat-card">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <div class="stat-number text-success"><%= stats.foundCount %></div>
          <div class="text-muted small fw-semibold">Found Items Reported</div>
        </div>
        <div class="stat-icon bg-success bg-opacity-10 text-success">
          <i class="bi bi-check-circle"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-lg-3">
    <div class="stat-card">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <div class="stat-number text-warning"><%= stats.pendingClaimsCount %></div>
          <div class="text-muted small fw-semibold">My Pending Claims</div>
        </div>
        <div class="stat-icon bg-warning bg-opacity-10 text-warning">
          <i class="bi bi-hourglass-split"></i>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row g-4">
  <!-- Left Column: Recent Reports Created by User -->
  <div class="col-lg-7">
    <div class="card border-0 shadow-sm rounded-4 h-100">
      <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-navy">
          <i class="bi bi-journal-text me-2 text-primary"></i> My Recent Reports
        </h5>
        <a href="/items/my-reports" class="btn btn-sm btn-outline-custom">View All Reports</a>
      </div>
      <div class="card-body p-0">
        <% if (recentReports && recentReports.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light small">
                <tr>
                  <th class="ps-3">Item</th>
                  <th>Type</th>
                  <th>Status</th>
                  <th>Date</th>
                  <th class="text-end pe-3">Action</th>
                </tr>
              </thead>
              <tbody>
                <% recentReports.forEach(item => { %>
                  <tr>
                    <td class="ps-3">
                      <div class="d-flex align-items-center">
                        <img src="<%= item.imageUrl %>" alt="<%= item.title %>" class="rounded me-2" style="width: 40px; height: 40px; object-fit: cover;" onerror="this.src='/images/default-item.svg'">
                        <div>
                          <a href="/items/<%= item._id %>" class="fw-semibold text-dark text-decoration-none text-truncate d-block" style="max-width: 180px;">
                            <%= item.title %>
                          </a>
                          <small class="text-muted"><%= item.category %></small>
                        </div>
                      </div>
                    </td>
                    <td>
                      <span class="badge <%= item.type === 'lost' ? 'bg-danger' : 'bg-success' %> text-uppercase" style="font-size: 0.7rem;">
                        <%= item.type %>
                      </span>
                    </td>
                    <td>
                      <span class="badge badge-status-<%= item.status %>" style="font-size: 0.75rem;">
                        <%= item.status %>
                      </span>
                    </td>
                    <td class="small text-muted">
                      <%= new Date(item.itemDate).toLocaleDateString() %>
                    </td>
                    <td class="text-end pe-3">
                      <a href="/items/<%= item._id %>" class="btn btn-sm btn-light border py-1 px-2" title="View details">
                        <i class="bi bi-eye"></i>
                      </a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="text-center py-5">
            <i class="bi bi-inbox text-muted fs-1 mb-2 d-block"></i>
            <h6 class="fw-bold">No reports submitted yet</h6>
            <p class="text-muted small mb-3">Report an item you lost or found to start tracking.</p>
            <div class="d-flex justify-content-center gap-2">
              <a href="/items/report-lost" class="btn btn-sm btn-danger">Report Lost</a>
              <a href="/items/report-found" class="btn btn-sm btn-accent-custom">Report Found</a>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Right Column: My Claims & Quick Actions -->
  <div class="col-lg-5">
    <!-- Claims Summary Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
      <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-navy">
          <i class="bi bi-shield-check me-2 text-primary"></i> My Ownership Claims
        </h5>
        <a href="/claims/my-claims" class="btn btn-sm btn-outline-custom">View All</a>
      </div>
      <div class="card-body p-3">
        <% if (myClaims && myClaims.length > 0) { %>
          <div class="list-group list-group-flush">
            <% myClaims.forEach(claim => { %>
              <a href="/claims/<%= claim._id %>" class="list-group-item list-group-item-action px-2 py-3 border-bottom d-flex justify-content-between align-items-center">
                <div class="pe-2">
                  <div class="fw-bold text-dark text-truncate" style="max-width: 220px;">
                    <%= claim.item ? claim.item.title : 'Item Removed' %>
                  </div>
                  <small class="text-muted">
                    Claimed on <%= new Date(claim.createdAt).toLocaleDateString() %>
                  </small>
                </div>
                <div>
                  <% if (claim.status === 'pending') { %>
                    <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>Pending</span>
                  <% } else if (claim.status === 'approved') { %>
                    <span class="badge bg-success"><i class="bi bi-check-lg me-1"></i>Approved</span>
                  <% } else { %>
                    <span class="badge bg-danger"><i class="bi bi-x-lg me-1"></i>Rejected</span>
                  <% } %>
                </div>
              </a>
            <% }) %>
          </div>
        <% } else { %>
          <div class="text-center py-4">
            <i class="bi bi-patch-question text-muted fs-2 mb-2 d-block"></i>
            <p class="text-muted small mb-0">You have not submitted any ownership claims yet.</p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Quick Help & Guidelines -->
    <div class="card border-0 shadow-sm rounded-4 bg-light">
      <div class="card-body p-4">
        <h6 class="fw-bold text-navy mb-2"><i class="bi bi-lightbulb me-2 text-warning"></i> Quick Safety Tips</h6>
        <ul class="small text-muted ps-3 mb-0 d-flex flex-column gap-2">
          <li>Never share personal passwords, PINs, or sensitive credentials in public descriptions.</li>
          <li>When meeting a finder to recover an item, choose a public campus location or the security desk.</li>
          <li>Provide proof (such as lock screen wallpapers or receipts) when claiming high-value electronics.</li>
        </ul>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
