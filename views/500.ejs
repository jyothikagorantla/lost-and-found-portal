<%- include('partials/header') %>

<div class="row justify-content-center py-5">
  <div class="col-lg-6 col-md-8 text-center">
    <div class="p-5 bg-white rounded-4 shadow-sm border">
      <div class="text-danger mb-3">
        <i class="bi bi-exclamation-triangle fs-1" style="font-size: 4rem;"></i>
      </div>
      <h1 class="display-5 fw-bold text-navy mb-2"><%= typeof statusCode !== 'undefined' ? statusCode : '500' %></h1>
      <h4 class="fw-bold mb-3">Something Went Wrong</h4>
      <p class="text-muted mb-4">
        <%= typeof message !== 'undefined' ? message : 'An unexpected server error occurred while processing your request. Please try again shortly.' %>
      </p>

      <% if (typeof stack !== 'undefined' && stack) { %>
        <div class="text-start bg-light p-3 rounded-3 border mb-4 font-monospace small" style="max-height: 200px; overflow-y: auto;">
          <%= stack %>
        </div>
      <% } %>

      <div class="d-flex justify-content-center gap-2">
        <a href="/" class="btn btn-primary-custom px-4 py-2">
          <i class="bi bi-house-door me-1"></i> Return to Safety
        </a>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
